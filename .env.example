# --- IB Gateway credentials (consumed by ghcr.io/gnzsnz/ib-gateway) ---
TWS_USERID=your_ibkr_username
TWS_PASSWORD=your_ibkr_password

# live or paper
TRADING_MODE=paper

# --- Proxy ---
# Host port the FastAPI proxy is published on
APP_PORT=5001

# Unique client id for this proxy (different per concurrent proxy)
IBKR_CLIENT_ID=1

# Optional: external webhook for fills / order status events.
# Leave blank to disable webhook forwarding.
WEBHOOK_URL=

# --- IB Gateway tuning ---
TWOFA_TIMEOUT_ACTION=restart
RELOGIN_AFTER_TWOFA_TIMEOUT=yes
TIME_ZONE=Etc/UTC

# Set to enable VNC (useful for first-time 2FA or troubleshooting).
# Exposed on host port 5900 only when set.
VNC_SERVER_PASSWORD=

# How long (seconds) to wait for the IB Gateway API socket to come up
IB_API_READY_TIMEOUT=180
